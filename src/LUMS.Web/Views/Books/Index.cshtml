@model BookSearchViewModel
@{
    ViewData["Title"] = "Tra cứu sách";
}

<h1 class="page-title">Tra cứu sách (OPAC)</h1>
<p class="page-sub">Tìm kiếm theo tên sách, tác giả, thể loại hoặc ISBN</p>

<form method="get" class="opac-form" role="search">
    <div class="opac-form__row">
        <label class="sr-only" for="keyword">Từ khóa</label>
        <input id="keyword" name="keyword" type="search" value="@Model.Keyword" placeholder="Nhập tên sách, tác giả, ISBN..." autocomplete="off" />
        <button class="btn btn--outline-strong" type="submit">Tìm kiếm</button>
    </div>

    <div class="chips">
        <vc:book-filters category="@Model.Category" author="@Model.Author" status="@Model.Status" />
        @if (Model.HasFilter)
        {
            <a class="chip chip--link" asp-controller="Books" asp-action="Index">Xóa bộ lọc</a>
        }
    </div>
</form>

<h2 class="section-title section-title--sm">Kết quả tìm kiếm (@Model.Result.TotalCount sách)</h2>

@if (Model.Result.Items.Count == 0)
{
    <div class="empty">
        <p><strong>Không tìm thấy sách phù hợp.</strong></p>
        <p>Hãy thử từ khóa ngắn hơn hoặc <a asp-controller="Books" asp-action="Index">xóa bộ lọc</a>.</p>
    </div>
}
else
{
    <div class="book-grid">
        @foreach (var book in Model.Result.Items)
        {
            <partial name="_BookCard" model="book" />
        }
    </div>

    <partial name="_Pager" model="Model.Pager" />
}
