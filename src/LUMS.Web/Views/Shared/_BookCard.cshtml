@model BookSummaryDto
@{
    var compact = ViewData["Compact"] is true;
}
<article class="book-card">
    <a class="book-card__link" asp-controller="Books" asp-action="Details" asp-route-id="@Model.Id" aria-label="@Model.Title">
        <div class="book-card__cover">
            @if (!string.IsNullOrEmpty(Model.CoverImage))
            {
                <img src="@Model.CoverImage" alt="Bìa sách @Model.Title" loading="lazy" />
            }
            else
            {
                <span class="book-card__placeholder">[Ảnh bìa sách]</span>
            }
            @if (!compact)
            {
                <span class="badge book-card__badge @DisplayText.AvailabilityBadge(Model.Availability)">@DisplayText.AvailabilityName(Model.Availability)</span>
            }
        </div>
        <h3 class="book-card__title">@Model.Title</h3>
        @if (!compact)
        {
            <p class="book-card__meta">Tác giả: @Model.Author</p>
            <p class="book-card__meta">Thể loại: @Model.Category</p>
            <p class="book-card__meta">Vị trí kệ: @Model.Shelf</p>
        }
    </a>
</article>
