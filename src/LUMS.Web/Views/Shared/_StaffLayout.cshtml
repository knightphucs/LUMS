<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
</head>
<body class="body--staff">
    <a class="skip-link" href="#main">Bỏ qua điều hướng</a>

    <header class="topbar">
        <div class="topbar__inner">
            <h1 class="topbar__title">@(ViewData["Title"] ?? "Khu vực nhân viên")</h1>
            <nav class="topnav" aria-label="Điều hướng nhân viên">
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <a class="@ViewContext.ActiveClass("Admin", "Dashboard")" asp-controller="Admin" asp-action="Dashboard">Bảng điều khiển</a>
                }
                <a class="@ViewContext.ActiveClass("Staff", "Books")" asp-controller="Staff" asp-action="Books">Kho sách</a>
                <a asp-controller="Books" asp-action="Index">Tra cứu OPAC</a>
            </nav>
            <div class="topbar__actions">
                <partial name="_UserMenu" />
            </div>
        </div>
    </header>

    <main id="main" class="page page--wide">
        @RenderBody()
    </main>

    <partial name="_Scripts" />
</body>
</html>
