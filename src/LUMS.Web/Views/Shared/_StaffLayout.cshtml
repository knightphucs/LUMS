<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
</head>
<body class="body--staff">
    <a class="skip-link" href="#main">Bỏ qua điều hướng</a>

    @{
        var current = $"/{ViewContext.RouteData.Values["controller"]}/{ViewContext.RouteData.Values["action"]}";
    }
    <header class="topbar">
        <div class="topbar__inner">
            <h1 class="topbar__title">@(ViewData["Title"] ?? "Khu vực nhân viên")</h1>
            <nav class="topnav" aria-label="Điều hướng nhân viên">
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <a class="@(current == "/Admin/Dashboard" ? "is-active" : "")" asp-controller="Admin" asp-action="Dashboard">Bảng điều khiển</a>
                }
                <a class="@(current == "/Staff/Books" ? "is-active" : "")" asp-controller="Staff" asp-action="Books">Kho sách</a>
                <a asp-controller="Books" asp-action="Index">Tra cứu OPAC</a>
            </nav>
            <div class="topbar__actions">
                <partial name="_UserMenu" />
            </div>
        </div>
    </header>

    <main id="main" class="page page--wide">
        @RenderBody()
    </main>

    <div id="toast-region" class="toast-region" role="status" aria-live="polite"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
