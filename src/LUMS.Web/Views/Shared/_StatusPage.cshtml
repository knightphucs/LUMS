@model ErrorViewModel
@using LUMS.Web.Security

<section class="status-page">
    <div class="status-page__code" aria-hidden="true">@Model.Code</div>
    <h1>@Model.Heading</h1>
    <p>@Model.Message</p>
    @if (Model.RequestId is not null)
    {
        <p class="muted">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }

    <div class="status-page__actions">
        @if (Model.Code == 403)
        {
            <a class="btn btn--primary"
               href="@RoleHome.UrlFor(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)">
                Về trang của bạn
            </a>
        }

        <a class="btn btn--primary"
           asp-controller="Home"
           asp-action="Index">
            Về trang chủ
        </a>
    </div>
</section>
