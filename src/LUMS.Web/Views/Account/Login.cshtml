@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-card">
    <h1>Đăng nhập</h1>

    <form method="post" asp-controller="Account" asp-action="Login" novalidate>
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

        @if (ViewData.ModelState.TryGetValue(string.Empty, out var formState) && formState.Errors.Count > 0)
        {
            <div class="alert alert--danger" role="alert">
                @foreach (var error in formState.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="field">
            <label asp-for="Identifier"></label>
            <input asp-for="Identifier" placeholder="example@lums.edu.vn" autocomplete="username" autofocus />
            <span class="field__error" asp-validation-for="Identifier"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label>
            <div class="field__password">
                <input asp-for="Password" placeholder="••••••••" autocomplete="current-password" />
                <button type="button" class="field__toggle" data-toggle-password aria-label="Hiện/ẩn mật khẩu">Hiện</button>
            </div>
            <span class="field__error" asp-validation-for="Password"></span>
            <a class="field__help" href="#" data-toast="Chức năng quên mật khẩu chưa nằm trong phạm vi bản demo.">Quên mật khẩu?</a>
        </div>

        <label class="check">
            <input asp-for="RememberMe" />
            <span>Ghi nhớ đăng nhập</span>
        </label>

        <button class="btn btn--primary btn--block" type="submit">Đăng nhập</button>
    </form>

    <div class="auth-card__foot">
        Chưa có tài khoản?
        <a href="#" data-toast="Đăng ký tài khoản (UC-00-02) chưa nằm trong phạm vi bản demo.">Đăng ký ngay</a>
    </div>

    @if (ViewData["ShowDemoAccounts"] is true)
    {
        <details class="demo-accounts">
            <summary>Tài khoản demo (môi trường Development)</summary>
            <table class="table table--compact">
                <thead><tr><th>Vai trò</th><th>Đăng nhập bằng</th></tr></thead>
                <tbody>
                    <tr><td>Độc giả</td><td><code>22300123</code></td></tr>
                    <tr><td>Thủ thư</td><td><code>NV001</code></td></tr>
                    <tr><td>Admin</td><td><code>admin@lums.edu.vn</code></td></tr>
                </tbody>
            </table>
            <p>Mật khẩu chung: <code>Lums@12345</code></p>
        </details>
    }
</div>
