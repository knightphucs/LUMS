@model BookSearchViewModel
@{
    ViewData["Title"] = "Quản lý kho sách";
}

<form method="get" class="toolbar" role="search">
    <label class="sr-only" for="keyword">Tìm theo tên sách</label>
    <input id="keyword" class="toolbar__search" name="keyword" type="search" value="@Model.Keyword" placeholder="Tìm theo tên sách / tác giả..." autocomplete="off" />

    <label class="chip chip--rect">
        <span class="sr-only">Thể loại</span>
        <select name="category" data-autosubmit>
            <option value="">Thể loại</option>
            @foreach (var c in Model.Filters.Categories)
            {
                <option value="@c" selected="@(c == Model.Category)">@c</option>
            }
        </select>
    </label>
    <label class="chip chip--rect">
        <span class="sr-only">Tình trạng</span>
        <select name="status" data-autosubmit>
            <option value="">Tình trạng</option>
            <option value="instock" selected="@(Model.Status == "instock")">Còn sách</option>
            <option value="outofstock" selected="@(Model.Status == "outofstock")">Hết sách</option>
        </select>
    </label>

    <span class="toolbar__spacer"></span>
    <button type="button" class="btn btn--outline-muted" data-toast="Xuất Excel (UC-02-05) chưa nằm trong phạm vi bản demo.">Xuất Excel</button>
    <button type="button" class="btn btn--primary" data-open-dialog="book-dialog">+ Thêm sách mới</button>
</form>

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên sách</th>
                <th>Tác giả</th>
                <th>Thể loại</th>
                <th>Vị trí kệ</th>
                <th>Bản sao</th>
                <th>Tình trạng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Result.Items)
            {
                <tr>
                    <td>@b.Id</td>
                    <td><a asp-controller="Books" asp-action="Details" asp-route-id="@b.Id">@b.Title</a></td>
                    <td>@b.Author</td>
                    <td>@b.Category</td>
                    <td>@b.Shelf</td>
                    <td>@b.AvailableCopies/@b.TotalCopies</td>
                    <td><span class="badge @DisplayText.AvailabilityBadge(b.Availability)">@DisplayText.AvailabilityName(b.Availability)</span></td>
                </tr>
            }
            @if (Model.Result.Items.Count == 0)
            {
                <tr><td colspan="7" class="muted center">Không có sách phù hợp.</td></tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />

<dialog id="book-dialog" class="dialog" aria-labelledby="book-dialog-title">
    <form method="dialog" data-toast-on-submit="Bản demo giao diện: lưu sách (UC-02-03) sẽ được nối với BookService ở giai đoạn sau.">
        <h2 id="book-dialog-title">Thêm / Sửa thông tin sách</h2>
        <div class="field"><label for="f-title">Tên sách</label><input id="f-title" type="text" required /></div>
        <div class="field"><label for="f-author">Tác giả</label><input id="f-author" type="text" required /></div>
        <div class="field"><label for="f-cat">Thể loại</label><input id="f-cat" type="text" /></div>
        <div class="field"><label for="f-isbn">Mã ISBN</label><input id="f-isbn" type="text" /></div>
        <div class="field"><label for="f-shelf">Vị trí kệ (Shelf location)</label><input id="f-shelf" type="text" /></div>
        <div class="field"><label for="f-copies">Số lượng bản sao (Copies)</label><input id="f-copies" type="number" min="1" /></div>
        <div class="dialog__actions">
            <button type="submit" class="btn btn--primary">Lưu (Save)</button>
            <button type="button" class="btn btn--outline-muted" data-close-dialog>Hủy</button>
        </div>
    </form>
</dialog>
