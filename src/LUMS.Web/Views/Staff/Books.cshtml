@model BookSearchViewModel
@{
    ViewData["Title"] = "Quản lý kho sách";
    var flash = TempData["Flash"] as string;
    var error = TempData["Error"] as string;
}

@if (!string.IsNullOrEmpty(flash))
{
    <div class="alert alert--ok" role="status">@flash</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert--danger" role="alert">@error</div>
}

<form method="get" class="toolbar" role="search">
    <label class="sr-only" for="keyword">Tìm theo tên sách</label>
    <input id="keyword" class="toolbar__search" name="keyword" type="search" value="@Model.Keyword" placeholder="Tìm theo tên sách / tác giả..." autocomplete="off" />

    <vc:book-filters category="@Model.Category" status="@Model.Status" staff="true" />

    <span class="toolbar__spacer"></span>
    <button type="button" class="btn btn--outline-muted" data-toast="Xuất Excel (UC-02-05) chưa nằm trong phạm vi bản demo.">Xuất Excel</button>
    <button type="button" class="btn btn--primary" data-open-dialog="book-dialog">+ Thêm sách mới</button>
</form>

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên sách</th>
                <th>Tác giả</th>
                <th>Thể loại</th>
                <th>Vị trí kệ</th>
                <th>Bản sao</th>
                <th>Tình trạng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Result.Items)
            {
                <tr>
                    <td>@b.Id</td>
                    <td><a asp-controller="Books" asp-action="Details" asp-route-id="@b.Id">@b.Title</a></td>
                    <td>@b.Author</td>
                    <td>@b.Category</td>
                    <td>@b.Shelf</td>
                    <td>@b.AvailableCopies/@b.TotalCopies</td>
                    <td><span class="badge @DisplayText.AvailabilityBadge(b.Availability)">@DisplayText.AvailabilityName(b.Availability)</span></td>
                </tr>
            }
            @if (Model.Result.Items.Count == 0)
            {
                <tr><td colspan="7" class="muted center">Không có sách phù hợp.</td></tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />

<partial name="_BookDialog" />
